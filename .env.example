# ---------------------------------------------------------------------------
# ClinicFlow frontend environment
# Copy this file to .env and fill in the values from your Supabase project.
# Only the PUBLIC anon key belongs here. Never put a service_role key in this
# file or anywhere in the frontend bundle.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Clinic branding used on the app shell and generated PDF invoices.
VITE_CLINIC_NAME=ClinicFlow Clinic
VITE_CLINIC_ADDRESS=12 Health Street, Suite 4
VITE_CLINIC_PHONE=+1 (555) 010-2030
VITE_CLINIC_EMAIL=billing@clinicflow.example
VITE_CLINIC_CURRENCY=USD

# IANA timezone the clinic operates in. Must match the database setting
# `clinicflow.timezone` (see README). Defaults to UTC.
VITE_CLINIC_TIMEZONE=UTC
