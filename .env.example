# ---------------------------------------------------------------------------
# ClinicFlow · environment template
# Copy to .env and fill in the values. .env is git-ignored.
#
# Only SUPABASE_ANON_KEY is ever sent to the browser (through /api/config.js).
# SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY stay in the Python backend and
# must never be placed in frontend files.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-side only. Used by the email endpoints to read auth emails and rows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Transactional email (Resend) ----------------------------------------
# https://resend.com → API Keys. Verify your sending domain first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ClinicFlow <no-reply@yourclinic.com>

# --- Clinic branding (public) --------------------------------------------
CLINIC_NAME=ClinicFlow Clinic
CLINIC_ADDRESS=12 Health Street, Suite 4
CLINIC_PHONE=+1 (555) 010-2030
CLINIC_EMAIL=billing@clinicflow.example
CLINIC_CURRENCY=USD
# IANA timezone. Must match the database setting `clinicflow.timezone`.
CLINIC_TIMEZONE=UTC

# --- Python server -------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Origin used for CORS and auth redirects (no trailing slash).
APP_ORIGIN=http://localhost:8000
# Optional: absolute backend URL for the browser (defaults to same origin).
API_BASE_URL=
